<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DisciplineAlarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowBackground">@color/dark_background</item>
    </style>

    <style name="Theme.DisciplineAlarm.FullScreenAlarm" parent="Theme.DisciplineAlarm">
        <item name="android:showWhenLocked">true</item>
        <item name="android:turnScreenOn">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
